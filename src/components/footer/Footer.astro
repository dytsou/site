---
import {
  FOOTER_QUICK_LINKS,
  FOOTER_SOCIAL_LINKS,
} from '../../data/footer-links';
import './Footer.css';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div>
        <h3 class="footer-brand">Dong-You Tsou</h3>
        <p class="footer-description">
          A full-stack developer passionate about building scalable systems and
          leading developer communities.
        </p>
      </div>

      <div
        class="footer-section-collapsed"
        data-expandable
        data-expandable-mobile
      >
        <h4 class="footer-section-title">
          Quick Links
          <button
            type="button"
            class="footer-section-toggle"
            data-expandable-toggle
            aria-label="Expand section"
          >
            <svg
              class="footer-section-toggle-icon"
              data-expandable-icon="down"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            <svg
              class="footer-section-toggle-icon hidden"
              data-expandable-icon="up"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m18 15-6-6-6 6"></path>
            </svg>
          </button>
        </h4>
        <div class="footer-section-content" data-expandable-content>
          <ul class="footer-links">
            {
              FOOTER_QUICK_LINKS.map((link) => (
                <li>
                  {link.internal ? (
                    <a href={link.href} class="footer-link">
                      {link.label}
                    </a>
                  ) : (
                    <a
                      href={link.href}
                      class="footer-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="footer-section-collapsed"
        data-expandable
        data-expandable-mobile
      >
        <h4 class="footer-section-title">
          Connect
          <button
            type="button"
            class="footer-section-toggle"
            data-expandable-toggle
            aria-label="Expand section"
          >
            <svg
              class="footer-section-toggle-icon"
              data-expandable-icon="down"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            <svg
              class="footer-section-toggle-icon hidden"
              data-expandable-icon="up"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m18 15-6-6-6 6"></path>
            </svg>
          </button>
        </h4>
        <div class="footer-section-content" data-expandable-content>
          <div class="footer-social-container">
            {
              FOOTER_SOCIAL_LINKS.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-social-link"
                  aria-label={social.label}
                >
                  {social.icon === 'github' && (
                    <svg
                      class="footer-social-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  )}
                  {social.icon === 'linkedin' && (
                    <svg
                      class="footer-social-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect width="4" height="12" x="2" y="9" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  )}
                  {social.icon === 'mail' && (
                    <svg
                      class="footer-social-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect width="20" height="16" x="2" y="4" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  )}
                  {social.icon === 'send' && (
                    <svg
                      class="footer-social-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
                      <path d="m21.854 2.147-10.94 10.939" />
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="footer-divider">
      <p class="footer-copyright">
        {currentYear} Dong-You Tsou. All rights reserved.
      </p>
    </div>
  </div>
</footer>
