---
import Section from '../layout/Section.astro';
import SectionHeader from '../layout/SectionHeader.astro';
import '../contact/Contact.css';
import '../ui/Button.css';

const CONTACT_CARDS = [
  {
    platform: 'linkedin',
    title: 'LinkedIn',
    subtitle: 'linkedin.com/in/dytsou/',
    url: 'https://www.linkedin.com/in/dytsou/',
  },
  {
    platform: 'github',
    title: 'GitHub',
    subtitle: '@dytsou',
    url: 'https://github.com/dytsou',
  },
  {
    platform: 'email',
    title: 'Email Me',
    subtitle: 'contact@dy.tsou.me',
    url: 'mailto:contact@dy.tsou.me',
  },
] as const;

const OPPORTUNITIES = [
  { label: 'Backend Development Roles', color: 'blue' },
  { label: 'Full-Stack Engineering Positions', color: 'cyan' },
  { label: 'Research Collaborations', color: 'green' },
  { label: 'Quality Assurance Engineering Positions', color: 'purple' },
] as const;
---

<Section id="contact">
  <SectionHeader
    title="Get In Touch"
    subtitle="I'm always open to discussing new projects, opportunities, or just having a chat about technology"
  />

  <div class="contact-container">
    <div class="contact-shell">
      <div class="contact-panel contact-panel-connect">
        <h3 class="contact-title">Let's Connect</h3>
        <div class="contact-grid" aria-label="Contact links">
          {
            CONTACT_CARDS.map((card) => (
              <a
                href={card.url}
                target={card.platform === 'email' ? undefined : '_blank'}
                rel={
                  card.platform === 'email' ? undefined : 'noopener noreferrer'
                }
                class={`contact-card contact-card-${card.platform} group stroke-icon-host`}
                aria-label={`${card.title}${card.platform === 'email' ? '' : ' (opens in a new tab)'}`}
              >
                <div
                  class={`contact-card-icon contact-card-icon-${card.platform}`}
                >
                  {card.platform === 'linkedin' && (
                    <svg
                      class="contact-card-icon-svg stroke-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path
                        pathLength="1"
                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                      />
                      <rect pathLength="1" width="4" height="12" x="2" y="9" />
                      <circle pathLength="1" cx="4" cy="4" r="2" />
                    </svg>
                  )}
                  {card.platform === 'github' && (
                    <svg
                      class="contact-card-icon-svg stroke-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path
                        pathLength="1"
                        d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                      />
                      <path pathLength="1" d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  )}
                  {card.platform === 'email' && (
                    <svg
                      class="contact-card-icon-svg stroke-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect
                        pathLength="1"
                        width="20"
                        height="16"
                        x="2"
                        y="4"
                        rx="2"
                      />
                      <path
                        pathLength="1"
                        d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                      />
                    </svg>
                  )}
                </div>
                <div class="contact-card-content">
                  <div class="contact-card-title">{card.title}</div>
                  <div
                    class={`contact-card-subtitle contact-card-subtitle-${card.platform}`}
                  >
                    {card.subtitle}
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <div class="opportunity-container">
        <h4 class="opportunity-title">Looking for opportunities in:</h4>
        <div class="opportunity-grid">
          {
            OPPORTUNITIES.map((opp) => (
              <div class="opportunity-item">
                <span class={`opportunity-dot opportunity-dot-${opp.color}`} />
                <span class="opportunity-label">{opp.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Section>
