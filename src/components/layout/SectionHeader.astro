---
interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className = '' } = Astro.props;
---

<div class:list={['section-header', className]}>
  <h2 class="section-title" data-reveal>{title}</h2>
  <div class="section-divider" data-reveal></div>
  {
    subtitle && (
      <p class="section-subtitle" data-reveal>
        {subtitle}
      </p>
    )
  }
</div>

<style is:global>
  @import './Section.css';
</style>
