---
import RepoCard from './RepoCard.astro';
import { GITHUB_ACTIVITY_REPOS } from '../../data/GitHubActivity.generated';
import './github-activity/GitHubActivity.css';

const repos = GITHUB_ACTIVITY_REPOS.slice(0, 6);
---

{
  repos.length > 0 && (
    <div class="github-activity" data-github-activity>
      <h3 class="github-activity-title">Recent GitHub Activity</h3>
      <p
        class="github-activity-status sr-only"
        data-github-activity-status
        aria-live="polite"
        aria-atomic="true"
      />

      <div class="github-repos-grid" data-github-repos>
        {repos.map((repo) => (
          <RepoCard repo={repo} />
        ))}
      </div>

      <div class="github-button-container">
        <a
          href="https://github.com/dytsou"
          target="_blank"
          rel="noopener noreferrer"
          class="github-button"
        >
          <svg
            class="github-button-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          View More on GitHub
        </a>
      </div>
    </div>
  )
}

<script>
  import '../../scripts/client/github-activity';
</script>
