---
import type { Project } from '../../types/projects';
import { getProjectIconClasses } from '../../utils/project-icon';
import '../projects/project-card/ProjectCard.css';
import '../projects/ProjectIconUtils.css';
import '../ui/Button.css';

interface Props {
  project: Project;
  projectIndex: number;
  cardStyle: string;
}

const { project, projectIndex, cardStyle } = Astro.props;
const { iconClass } = getProjectIconClasses(project);
const visibleTechnologies = (project.technologies ?? []).slice(0, 5);
const visibleTags = (project.tags ?? []).slice(0, 5);
const hiddenCount =
  Math.max(0, (project.technologies?.length ?? 0) - 5) +
  Math.max(0, (project.tags?.length ?? 0) - 5);
---

<div
  class:list={['project-card', cardStyle]}
  data-project-card
  data-project-index={projectIndex}
>
  <div class="project-card-content">
    <div class="project-card-main">
      <div>
        <h3 class="project-title">
          <span class="project-title-content">
            <svg
              class:list={['project-icon', iconClass]}
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
              <path d="M2 12h20" />
            </svg>
            <span>{project.title}</span>
          </span>
        </h3>
        <div class="project-description-container">
          <p class="project-description project-description-collapsed">
            {project.description}
          </p>
        </div>
      </div>

      <div class="project-technologies">
        {
          visibleTechnologies.length > 0 && (
            <div class="project-technologies-row">
              {visibleTechnologies.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
              {hiddenCount > 0 && visibleTags.length === 0 && (
                <button
                  type="button"
                  class="project-tech-more-button"
                  data-project-tech-toggle
                  aria-label={`Show ${hiddenCount} more technologies and tags`}
                  aria-expanded="false"
                >
                  +{hiddenCount}
                </button>
              )}
            </div>
          )
        }
        {
          visibleTags.length > 0 && (
            <div class="project-tags-row">
              {visibleTags.map((tag) => (
                <span class="tech-tag tech-tag-hashtag">#{tag}</span>
              ))}
              {hiddenCount > 0 && (
                <button
                  type="button"
                  class="project-tech-more-button"
                  data-project-tech-toggle
                  aria-label={`Show ${hiddenCount} more technologies and tags`}
                  aria-expanded="false"
                >
                  +{hiddenCount}
                </button>
              )}
            </div>
          )
        }
      </div>
    </div>

    {
      project.github_url && (
        <div class="project-actions">
          <a
            href={project.github_url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-action-button project-action-github"
          >
            <svg
              class="project-action-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            Code
          </a>
        </div>
      )
    }
  </div>
</div>
