---
import type { GitHubActivityRepo } from '../../data/GitHubActivity.generated';

interface Props {
  repo: GitHubActivityRepo;
}

const { repo } = Astro.props;
const description = repo.description || '';
---

<a
  href={repo.html_url}
  target="_blank"
  rel="noopener noreferrer"
  class="repo-card group"
>
  <div class="repo-card-header">
    <h4 class="repo-card-title">{repo.name}</h4>
    <svg
      class="repo-card-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
      ></path>
      <path d="M9 18c-4.51 2-5-2-7-2"></path>
    </svg>
  </div>
  <div class="repo-card-description-wrapper">
    <p class="repo-card-description repo-card-description-clamped">
      {description}
    </p>
  </div>
  <div class="repo-card-footer">
    {
      repo.language && (
        <span class="language-indicator">
          <span class="language-dot" />
          {repo.language}
        </span>
      )
    }
    <span class="star-indicator">
      <svg
        class="star-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polygon
          points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
        ></polygon>
      </svg>
      {repo.stargazers_count}
    </span>
  </div>
</a>
