{
  "name": "dytsou@personal-site",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/emit-site-routes.mjs && node scripts/emit-agent-discovery.mjs && astro dev",
    "build": "node scripts/emit-site-routes.mjs && node scripts/emit-agent-discovery.mjs && pnpm sync && astro build && node scripts/verify-build.mjs",
    "lint": "eslint .",
    "sync": "pnpm sync:projects && pnpm sync:about-stats && pnpm sync:about-languages && pnpm sync:github-activity",
    "sync:projects": "node scripts/sync-projects.mjs",
    "sync:projects:offline": "NO_GITHUB_API=1 node scripts/sync-projects.mjs",
    "sync:about-languages": "node scripts/sync-about-languages.mjs",
    "sync:about-languages:offline": "NO_GITHUB_API=1 node scripts/sync-about-languages.mjs",
    "sync:about-stats": "node scripts/sync-about-stats.mjs",
    "sync:about-stats:offline": "NO_GITHUB_API=1 node scripts/sync-about-stats.mjs",
    "sync:github-activity": "node scripts/sync-github-activity.mjs",
    "sync:github-activity:offline": "NO_GITHUB_API=1 node scripts/sync-github-activity.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md,astro,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md,astro,mjs}\"",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler pages deploy ./dist --project-name=dy-tsou-me",
    "typecheck": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.7",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@babel/core": "8.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.16",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "wrangler": "4.104.0"
  },
  "overrides": {
    "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,astro}": [
      "prettier --write"
    ]
  }
}
