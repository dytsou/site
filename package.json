{
  "name": "dytsou@personal-site",
  "private": true,
  "version": "2.4.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/emit-site-routes.mjs && node scripts/emit-agent-discovery.mjs && astro dev",
    "build": "node scripts/sync-server-card.mjs && node scripts/emit-site-routes.mjs && node scripts/emit-agent-discovery.mjs && pnpm sync && node scripts/load-github-activity-snapshot.mjs && astro build && node scripts/verify-build.mjs && node scripts/verify-route-manifest.mjs",
    "verify:route-manifest": "node scripts/verify-route-manifest.mjs",
    "verify:deploy-contract": "node scripts/verify-deploy-contract.mjs",
    "verify:front-door": "node scripts/verify-front-door-routing.mjs",
    "verify:worker": "wrangler deploy --dry-run --config workers/front-door/wrangler.toml",
    "lint": "eslint .",
    "sync": "pnpm sync:projects && pnpm sync:about-stats && pnpm sync:about-languages && pnpm sync:server-card",
    "sync:server-card": "node scripts/sync-server-card.mjs",
    "sync:projects": "node scripts/sync-projects.mjs",
    "sync:projects:offline": "NO_GITHUB_API=1 node scripts/sync-projects.mjs",
    "sync:about-languages": "node scripts/sync-about-languages.mjs",
    "sync:about-languages:offline": "NO_GITHUB_API=1 node scripts/sync-about-languages.mjs",
    "sync:about-stats": "node scripts/sync-about-stats.mjs",
    "sync:about-stats:offline": "NO_GITHUB_API=1 node scripts/sync-about-stats.mjs",
    "sync:github-activity": "node scripts/sync-github-activity.mjs",
    "sync:github-activity:offline": "node scripts/load-github-activity-snapshot.mjs",
    "load:github-activity-snapshot": "node scripts/load-github-activity-snapshot.mjs",
    "generate:favicons": "node scripts/generate-favicon-pngs.mjs",
    "test:favicons": "node --test scripts/generate-favicon-pngs.test.mjs",
    "test:github-activity": "node --test scripts/github-activity-snapshot.test.mjs",
    "test:heatmap-contract": "node --test scripts/heatmap-contract.test.mjs",
    "test:heatmap-collector": "node --test scripts/heatmap-collector.test.mjs",
    "test:heatmap-ingestion": "node --test scripts/heatmap-ingestion.test.mjs workers/front-door/tests/ingestion.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md,astro,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md,astro,mjs}\"",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler pages deploy ./dist --project-name=dy-tsou-me",
    "typecheck": "astro check",
    "prepare": "husky",
    "test:heatmap-report": "node --test scripts/heatmap-access.test.mjs scripts/heatmap-report.test.mjs",
    "test:heatmap-preview": "node --test scripts/heatmap-preview.test.mjs scripts/heatmap-theme.test.mjs",
    "test:heatmap-build": "node --test scripts/heatmap-build.test.mjs",
    "test:heatmap": "node --test scripts/heatmap-contract.test.mjs scripts/heatmap-collector.test.mjs scripts/heatmap-ingestion.test.mjs scripts/heatmap-access.test.mjs scripts/heatmap-report.test.mjs scripts/heatmap-preview.test.mjs scripts/heatmap-theme.test.mjs scripts/heatmap-build.test.mjs workers/front-door/tests/ingestion.test.mjs",
    "verify:functions": "wrangler pages functions build functions --outdir .wrangler/heatmap-functions --output-routes-path .wrangler/heatmap-routes.json"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@babel/core": "8.0.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "4.137.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,astro}": [
      "prettier --write"
    ]
  }
}
