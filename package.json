{
  "name": "dytsou@personal-site",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm sync && vite build",
    "lint": "eslint .",
    "sync": "pnpm sync:projects && pnpm sync:about-stats && pnpm sync:about-languages",
    "sync:projects": "node scripts/sync-projects.mjs",
    "sync:projects:offline": "NO_GITHUB_API=1 node scripts/sync-projects.mjs",
    "sync:about-languages": "node scripts/sync-about-languages.mjs",
    "sync:about-languages:offline": "NO_GITHUB_API=1 node scripts/sync-about-languages.mjs",
    "sync:about-stats": "node scripts/sync-about-stats.mjs",
    "sync:about-stats:offline": "NO_GITHUB_API=1 node scripts/sync-about-stats.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/supabase-js": "^2.105.1",
    "lucide-react": "^1.14.0",
    "react": "19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
