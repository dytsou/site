{
  "name": "dytsou@personal-site",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm sync && vite build",
    "lint": "eslint .",
    "sync": "pnpm sync:projects && pnpm sync:about-stats && pnpm sync:about-languages",
    "sync:projects": "node scripts/sync-projects.mjs",
    "sync:projects:offline": "NO_GITHUB_API=1 node scripts/sync-projects.mjs",
    "sync:about-languages": "node scripts/sync-about-languages.mjs",
    "sync:about-languages:offline": "NO_GITHUB_API=1 node scripts/sync-about-languages.mjs",
    "sync:about-stats": "node scripts/sync-about-stats.mjs",
    "sync:about-stats:offline": "NO_GITHUB_API=1 node scripts/sync-about-stats.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/supabase-js": "^2.106.0",
    "lucide-react": "^1.16.0",
    "react": "19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13"
  },
  "overrides": {
    "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
