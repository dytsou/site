{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Front Door route manifest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["pathPrefix", "backend", "stripPrefix", "ownerRepo", "kind"],
    "additionalProperties": false,
    "properties": {
      "pathPrefix": {
        "type": "string",
        "pattern": "^/"
      },
      "backend": {
        "type": "string",
        "pattern": "^https://"
      },
      "stripPrefix": {
        "type": "string"
      },
      "ownerRepo": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+$"
      },
      "kind": {
        "type": "string",
        "enum": ["site", "page"]
      },
      "previewUrl": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  }
}
